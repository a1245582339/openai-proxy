# Pre-built base image - includes all system and Python dependencies
# This image can be built separately and pushed to a registry to avoid reinstalling dependencies each time
#
# Build commands:
#   docker build -f Dockerfile.base -t litellm-base:latest .
#   docker tag litellm-base:latest your-registry/litellm-base:latest
#   docker push your-registry/litellm-base:latest
#
FROM docker.1ms.run/python:3.11

LABEL maintainer="LiteLLM Proxy"
LABEL description="LiteLLM base image with all dependencies pre-installed"
LABEL version="1.0.0"

# Set up non-root user
RUN groupadd -r litellm && useradd -r -g litellm -s /bin/bash litellm

# Set working directory
WORKDIR /app

# Use China mirrors to accelerate apt-get and install minimal dependencies
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        openssl \
        curl \
        gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && pip3 install --no-cache-dir --upgrade pip \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --timeout 300 \
        --retries 5 \
    && pip3 install --no-cache-dir 'litellm[proxy]==1.40.19' \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --timeout 300 \
        --retries 5 \
    && pip3 cache purge

# Create necessary directories and set permissions
RUN mkdir -p /app/certs /app/config /app/logs \
    && chown -R litellm:litellm /app

# Switch to non-root user (preparation for subsequent layers)
USER litellm

# Set default environment variables
ENV PORT=8443
ENV HOST=0.0.0.0
ENV DEBUG=false