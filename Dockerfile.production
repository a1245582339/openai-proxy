# LiteLLM OpenAI-to-Claude Proxy
# Production-ready Docker image that supports direct docker run usage
#
# Note: This version uses a pre-built base image to speed up builds
# To use this Dockerfile, first build the base image:
#   docker build -f Dockerfile.base -t litellm-base:latest .
#
# Usage:
#   docker run -d -p 8443:8443 -e ANTHROPIC_API_KEY=your-key litellm-openai-proxy
#
FROM litellm-base:latest

LABEL maintainer="LiteLLM Proxy"
LABEL description="OpenAI API to Claude proxy service - Production Ready (Fast Build)"
LABEL version="1.0.3"
LABEL org.opencontainers.image.source="https://github.com/your-org/litellm-openai-proxy"
LABEL org.opencontainers.image.documentation="https://github.com/your-org/litellm-openai-proxy/README.md"

# Temporarily switch to root user to copy files and set permissions
USER root

# ===== Copy configuration files and scripts =====
# Use unified configuration file (supports both Docker and Shell script startup methods)
COPY proxy-config.yaml /app/config/proxy-config.yaml
COPY scripts/entrypoint.sh /app/entrypoint.sh

# Set permissions
RUN chmod +x /app/entrypoint.sh \
    && chown -R litellm:litellm /app/config /app/entrypoint.sh

# Switch back to non-root user
USER litellm

# Expose ports
EXPOSE 8443
EXPOSE 443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -k -f https://localhost:${PORT}/health || exit 1

# Set entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]

# Default command (can be overridden by docker run arguments)
CMD []