  #   litellm_params:
  #     model: huggingface/meta-llama/Llama-2-7b-chat-hf
  #     api_key: ${HUGGINGFACE_API_KEY}

# General settings
general_settings:
  master_key: null
  disable_auth: true
  enable_cors: true
  cors_origins: ["*"]
  disable_spend_logs: true
  set_verbose: ${DEBUG:-false}

# LiteLLM settings
litellm_settings:
  drop_params: true
  set_verbose: ${DEBUG:-false}
  request_timeout: 600
  num_retries: 3
  max_parallel_requests: 100
  disable_health_check: true
